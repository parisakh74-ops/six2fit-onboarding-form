# Safe-to-commit staging template. Never put Zoho credentials in VITE_* values.
VITE_APP_ENV=staging
VITE_ONBOARDING_BOOTSTRAP_PATH=/api/onboarding/bootstrap
VITE_ONBOARDING_SUBMIT_PATH=/api/onboarding/submit

# Server-only staging handoff configuration. Use the same values as Consult.
SIX2FIT_STAGING_MODE=true
SIX2FIT_STAGING_STORAGE_DIR=/home/tofitcom/tmp/six2fit-staging
SIX2FIT_STAGING_TOKEN_SECRET=replace-with-the-same-32-plus-character-secret
